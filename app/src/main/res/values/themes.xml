<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de l'activité : fond blanc immédiat, barres système gérées par Compose. -->
    <style name="Theme.Pylive" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pylive_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
    </style>

    <!-- Écran de démarrage de la bibliothèque core-splashscreen (API 26+). -->
    <style name="Theme.Pylive.Start" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_splash</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@style/Theme.Pylive</item>
    </style>
</resources>
